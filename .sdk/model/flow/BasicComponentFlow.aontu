# BasicComponentFlow

main: kit: flow: BasicComponentFlow:
{
  entity: "component",
  kind: "basic",
  name: "BasicComponentFlow",
  step: [
    {
      i: {
        ref: "component_ref01"
      }

      m: {
        page_access_group_id: "page_access_group01",
        page_access_user_id: "page_access_user01",
        page_id: "page01"
      }

      o: "create"
    }

    {
      m: {
        page_id: "page01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "component_ref01"
          }
        }
      ]
    }

    {
      d: {
        page_id: "page01"
      }

      i: {
        ref: "component_ref01",
        srcdatavar: "component_ref01_data",
        suffix: "_up0",
        textfield: "automation_email"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-component_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "component_ref01",
        srcdatavar: "component_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "component01",
        page_id: "page01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-component_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "component_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "component01",
        page_id: "page01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        page_id: "page01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "component_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicComponentFlow"
}