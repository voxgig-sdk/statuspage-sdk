# BasicIncidentFlow

main: kit: flow: BasicIncidentFlow:
{
  entity: "incident",
  kind: "basic",
  name: "BasicIncidentFlow",
  step: [
    {
      i: {
        ref: "incident_ref01"
      }

      m: {
        page_id: "page01"
      }

      o: "create"
    }

    {
      m: {
        page_id: "page01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "incident_ref01"
          }
        }
      ]
    }

    {
      d: {
        page_id: "page01"
      }

      i: {
        ref: "incident_ref01",
        srcdatavar: "incident_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-incident_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "incident_ref01",
        srcdatavar: "incident_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "incident01",
        page_id: "page01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-incident_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "incident_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "incident01",
        page_id: "page01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        page_id: "page01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "incident_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicIncidentFlow"
}